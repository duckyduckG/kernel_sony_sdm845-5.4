# Platform
CONFIG_MACH_XIAOMI=y
CONFIG_MACH_XIAOMI_SDM845=y

# pstore
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Xiaomi-Pstore
CONFIG_CMDLINE="ramoops_memreserve=4M cgroup_disable=pressure loglevel=8 ignore_loglevel printk.time=1 printk.devkmsg=on"
CONFIG_CMDLINE_EXTEND=y
